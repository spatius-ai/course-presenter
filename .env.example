# Required: from app.spatius.ai
SPATIUS_API_KEY=
SPATIUS_APP_ID=
# us-west (default) or your region
SPATIUS_REGION=us-west

# Optional: your own OpenAI key. Without it, the presenter uses 30 free Spatius starter minutes.
OPENAI_API_KEY=

# Optional: ElevenLabs voices (each person has their own voice, with a native voice for Arabic).
# Without it, the OpenAI voice is used. Your key needs text-to-speech access.
ELEVENLABS_API_KEY=

# Optional: where the page starts (the learner can still change it)
# Language: en, es, zh, ar, fr    Presenter: victor, grace, julian, nadia, camille
PRESENTER_LANG=en
PRESENTER_FACE=victor
# PORT=3000
