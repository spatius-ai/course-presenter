// Cloudflare Workers settings for the Course presenter. Used by "Deploy to Cloudflare" and by `npm run deploy`.
{
  "name": "course-presenter",
  "main": "server/worker.mjs",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "build": { "command": "npm run build" },
  "vars": {
    "SPATIUS_REGION": "us-west",
    "PRESENTER_LANG": "en",
    "PRESENTER_FACE": "victor"
  }
}
